{
  "expo": {
    "name": "Ithrive30",
    "slug": "Ithrive30",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ithrive30",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ithrive30.Ithrive30"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0B",
          "dark": {
            "backgroundColor": "#0B0B0B"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "iTHRIVE30 uses your photo library so you can pick your daily selfie.",
          "cameraPermission": "iTHRIVE30 uses your camera so you can take your daily selfie."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "iTHRIVE30 saves your daily selfies to an iTHRIVE30 album in your photos.",
          "savePhotosPermission": "iTHRIVE30 saves your daily selfies to an iTHRIVE30 album in your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "iTHRIVE30 uses motion data to count your daily steps."
        }
      ],
      "expo-sharing",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supportEmail": "bondiprojectglobal@gmail.com",
      "privacyPolicyUrl": "",
      "sentryDsn": "https://e8367d89fa93e3b996afdb08a09b9641@o4512076534775808.ingest.de.sentry.io/4512076584386640",
      "router": {},
      "eas": {
        "projectId": "b33c1435-886d-47e9-a900-e26c09b43cf8"
      }
    },
    "owner": "bondi-project-global",
    "backgroundColor": "#0B0B0B"
  }
}
